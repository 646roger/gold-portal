# --- Required ---
DATABASE_URL="postgresql://goldloan:goldloan@localhost:5432/goldloan"
# Demo/local admin access: shared secret sent as the x-admin-key header. NOT production authentication.
ADMIN_API_KEY="change-me-local-admin-key"

# --- Optional ---
PORT=4000
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173"
RATE_LIMIT_ENABLED=true
TRUST_PROXY=false

# --- AI assistant: FREE by default. No paid key is needed or used. ---
# Leave everything below empty/commented => clearly-labelled DEMO mode (scripted, not AI).
# Option A (free, local, no key): install Ollama, run `ollama pull llama3.1`, then:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# Option B (free tiers, free key): any OpenAI-compatible host with tool calling, e.g.
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1
#   Gemini      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1   (pick a ':free' model)
#   LLM_API_KEY=<your free key>      LLM_MODEL=<a free tool-calling model; check the host's current list>
LLM_PROVIDER=auto          # auto | openai | demo | anthropic (anthropic is optional and paid; only if you choose it)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=30000
LLM_MAX_TOOL_ITERATIONS=5
