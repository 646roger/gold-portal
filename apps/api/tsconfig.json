{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "noEmit": true, "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src", "tests", "prisma", "prisma.config.ts", "vitest.config.ts"]
}
